# LabFlow MCP server 的环境变量示例。
# 客户端把本文件里的变量放进它启动 MCP server 时的 env（见 mcp/README.md），
# 不要把真实密码提交进仓库。

# 应用地址。默认 http://127.0.0.1:9002，与 deploy/labflow.env 的 LABFLOW_PORT 对应。
LABFLOW_API_URL=http://127.0.0.1:9002

# 用哪个 LabFlow 账号访问。只读工具按这个账号的权限走：
# manager 才能看回收站和账号列表，chem/bio 只能看项目与批次。
LABFLOW_MCP_USERNAME=leader
LABFLOW_MCP_PASSWORD=labflow123

# 单次 HTTP 请求超时（秒）。应用没起时靠它快速失败，而不是挂住。
LABFLOW_MCP_TIMEOUT=10

# 是否注册 labflow_download_file。默认关闭：它会在本机落文件副本，
# 需要时再显式打开（该工具会如实标成 readOnlyHint=false）。
LABFLOW_MCP_ENABLE_DOWNLOAD=

# labflow_download_file 的默认落盘目录（相对路径按 MCP server 的工作目录算）。
LABFLOW_MCP_DOWNLOAD_DIR=mcp-downloads
